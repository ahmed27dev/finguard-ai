# Virtual environment. The folder is .venv, and a pattern of "venv/"
# does not match it - which would have committed torch and every model
# dependency.
.venv/
venv/
env/

__pycache__/
*.pyc
*.pyo
.pytest_cache/
.streamlit/

# Downloaded filings. Regenerable with:
#   python -m retrieval.fetch_filing <TICKER>
data/filings/*
data/raw/*

# Pipeline artifacts: parsed JSON, chunks, FAISS indexes, metrics,
# anomalies, explanations. All rebuilt by:
#   python pipeline.py --all --force
data/processed/*
data/results/*

# FinQA (~106 MB). Downloaded with the command in eval_retrieval.py.
data/finqa/*

# Keep the directory structure so a fresh clone runs without mkdir.
!data/**/.gitkeep

# data/labels/ is deliberately NOT ignored. The hand labels are original
# work and the flagging evaluation cannot be reproduced without them.

.env
.DS_Store
Thumbs.db