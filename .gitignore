# Filings and everything derived from them. A single 10-K is several MB and
# the processed JSON is larger again; both are reproducible from the source
# filing, so neither belongs in the repository.
data/filings/*
data/processed/*
data/raw/*
!data/filings/.gitkeep
!data/processed/.gitkeep
!data/raw/.gitkeep

# FAISS indexes
*.faiss
*.index

# Model caches, if anything downloads into the project
.cache/
models/
*.bin
*.safetensors

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Generated reports
finguard-*.html